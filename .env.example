# Eve / OpenAI
OPENAI_API_KEY=
# Required in production so the protected Next.js route can call Eve internally.
EVE_INTERNAL_TOKEN=

# Optional Eve agent tools. They receive only structured, redacted claims or a
# public URL without query parameters; they never receive raw user content.
GOOGLE_FACT_CHECK_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Exa MCP semantic public-source search. Keep disabled unless actively testing.
EXA_API_KEY=
EXA_ENABLED=false

# Neon PostgreSQL
# Use Neon's pooled URL at runtime and its direct URL for Prisma migrations.
DATABASE_BRANCH=staging
# Production seeding is blocked unless this is explicitly true for one command.
ALLOW_PRODUCTION_SEED=false
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Short-lived signed tickets. Generate with: openssl rand -base64 32
REPORT_TICKET_SECRET=
SHARE_TICKET_SECRET=

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
