# Eve / OpenAI
OPENAI_API_KEY=

# Optional external evidence. These run only after a user explicitly opts in.
# They enrich the assembled result and never change the AI tier.
GOOGLE_FACT_CHECK_API_KEY=
VIRUSTOTAL_API_KEY=

# Neon PostgreSQL
# Use Neon's pooled URL at runtime and its direct URL for Prisma migrations.
DATABASE_BRANCH=staging
# Production seeding is blocked unless this is explicitly true for one command.
ALLOW_PRODUCTION_SEED=false
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Short-lived signed tickets. Generate with: openssl rand -base64 32
REPORT_TICKET_SECRET=
SHARE_TICKET_SECRET=

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
