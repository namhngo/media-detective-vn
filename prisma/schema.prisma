generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Values intentionally match src/lib/schema.ts. That file remains the shared
// application contract; Prisma maps the same values onto Neon Postgres.
enum Source {
  screenshot
  text
}

enum Platform {
  zalo
  facebook
  phone_call
  email
  website
  other
}

enum Category {
  deepfake_impersonation
  timeshare_contract
  fake_prize
  investment_scam
  misinformation
  other
}

enum Technique {
  urgency
  fear
  authority
  scarcity
  social_proof
  secrecy
  emotional_bait
  decontextualization
  fabricated_evidence
  bandwagon
  character_attack
}

enum Tier {
  watch
  caution
  warning
}

enum ConfirmationSource {
  ai_detected
  user_reported
}

// Immutable lifecycle events for one structured report. Event rows never
// contain raw messages or screenshots; those stay in Eve session handling.
enum ReportEventType {
  analysis_created
  shared
  user_reported
  seeded
}

model Report {
  id                     String              @id @default(uuid())
  createdAt              DateTime            @default(now()) @map("created_at")

  source                 Source
  platform               Platform
  category               Category

  claims                 String[]            @default([])
  techniques             Technique[]         @default([])

  tier                   Tier
  riskScore              Int                 @map("risk_score")
  explanationEn          String              @map("explanation_en")

  moneyRequested         Boolean             @default(false) @map("money_requested")
  amountVnd              BigInt?             @map("amount_vnd")
  location               String?

  isSeed                 Boolean             @default(false) @map("is_seed")
  // Calibration fixtures for the dashboard. Never shown in the public gallery.
  isDemo                 Boolean             @default(false) @map("is_demo")
  isShared               Boolean             @default(false) @map("is_shared")
  confirmationSource     ConfirmationSource? @map("confirmation_source")

  // Clerk user ID stays backend-only. It is never exposed in the gallery.
  submittedByClerkId     String?             @map("submitted_by_clerk_id")
  sourceCitation         String?             @map("source_citation")

  // Prisma does normal CRUD; pgvector writes and searches use typed raw SQL.
  embedding              Unsupported("vector(1536)")?
  agentSessionId         String?             @unique @map("agent_session_id")

  events                 ReportEvent[]

  @@index([createdAt])
  @@index([tier])
  @@index([isShared])
  @@index([isSeed])
  @@index([isDemo])
  @@index([submittedByClerkId])
  @@map("reports")
}

model ReportEvent {
  id                     String          @id @default(uuid())
  reportId               String          @map("report_id")
  report                 Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type                   ReportEventType
  createdAt              DateTime        @default(now()) @map("created_at")

  // Present only for an authenticated Clerk actor; never exposed publicly.
  actorClerkId           String?         @map("actor_clerk_id")

  @@unique([reportId, type])
  @@index([reportId, createdAt])
  @@index([type, createdAt])
  @@map("report_events")
}
