generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Values intentionally match src/lib/schema.ts. That file remains the shared
// application contract; Prisma maps the same values onto Neon Postgres.
enum Source {
  screenshot
  text
}
enum Platform {
  zalo
  facebook
  phone_call
  email
  website
  other
}

enum Category {
  deepfake_impersonation
  timeshare_contract
  fake_prize
  investment_scam
  misinformation
  other
}

enum Technique {
  urgency
  fear
  authority
  scarcity
  social_proof
  secrecy
  emotional_bait
  decontextualization
  fabricated_evidence
  bandwagon
  character_attack
}

enum Tier {
  watch
  caution
  warning
}

enum ConfirmationSource {
  ai_detected
  user_reported
}

// Immutable lifecycle events for one structured report. Event rows never
// contain raw messages or screenshots; those stay in Eve session handling.
enum ReportEventType {
  analysis_created
  shared
  user_reported
  seeded
}

/// An application user, keyed by their Clerk identity. Clerk remains the source
/// of truth for profile data (name, email, avatar) — this table stores only
/// app-owned state, so there is nothing to keep in sync.
model User {
  id                  String   @id @default(uuid())
  clerkId             String   @unique @map("clerk_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Denormalized counters for O(1) dashboard reads. Maintained on every write
  // and rebuildable from reports/report_events via recomputeUserStats().
  totalChecks         Int      @default(0) @map("total_checks")
  totalReports        Int      @default(0) @map("total_reports")
  publicContributions Int      @default(0) @map("public_contributions")
  currentStreak       Int      @default(0) @map("current_streak")
  longestStreak       Int      @default(0) @map("longest_streak")
  categoriesSeen      Int      @default(0) @map("categories_seen")
  lastActiveOn        DateTime? @map("last_active_on") @db.Date

  reports             Report[]
  events              ReportEvent[]
  lightReveals        LightReveal[]

  @@map("users")
}

/// Curated media-literacy field notes. Only rows reviewed by a human are
/// exposed in the prize box; the source stays visible with every fact.
model MilFact {
  id        String   @id
  category  String
  fact      String
  source    String
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  reveals   LightReveal[]

  @@index([category, reviewed])
  @@map("mil_facts")
}

/// One opened light box. The unique pair prevents a user from receiving the
/// same reviewed MIL fact twice while preserving a lightweight reveal ledger.
model LightReveal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId    String   @map("fact_id")
  fact      MilFact  @relation(fields: [factId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, factId])
  @@index([userId, createdAt])
  @@map("light_reveals")
}

model Report {
  id                     String              @id @default(uuid())
  createdAt              DateTime            @default(now()) @map("created_at")

  source                 Source
  platform               Platform
  category               Category

  claims                 String[]            @default([])
  techniques             Technique[]         @default([])

  tier                   Tier
  riskScore              Int                 @map("risk_score")
  explanationEn          String              @map("explanation_en")

  moneyRequested         Boolean             @default(false) @map("money_requested")
  amountVnd              BigInt?             @map("amount_vnd")
  location               String?

  isSeed                 Boolean             @default(false) @map("is_seed")
  // Calibration fixtures for the dashboard. Never shown in the public gallery.
  isDemo                 Boolean             @default(false) @map("is_demo")
  isShared               Boolean             @default(false) @map("is_shared")
  confirmationSource     ConfirmationSource? @map("confirmation_source")

  // Clerk user ID stays backend-only. It is never exposed in the gallery.
  submittedByClerkId     String?             @map("submitted_by_clerk_id")
  // Referential link to the app user. SetNull on delete: a deleted account
  // leaves its published case in the library, anonymized, never orphaned.
  userId                 String?             @map("user_id")
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceCitation         String?             @map("source_citation")

  // Prisma does normal CRUD; pgvector writes and searches use typed raw SQL.
  embedding              Unsupported("vector(1536)")?
  agentSessionId         String?             @unique @map("agent_session_id")

  events                 ReportEvent[]

  @@index([createdAt])
  @@index([tier])
  @@index([isShared])
  @@index([isSeed])
  @@index([isDemo])
  @@index([submittedByClerkId])
  @@index([userId])
  @@map("reports")
}

model ReportEvent {
  id                     String          @id @default(uuid())
  reportId               String          @map("report_id")
  report                 Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type                   ReportEventType
  createdAt              DateTime        @default(now()) @map("created_at")

  // Present only for an authenticated Clerk actor; never exposed publicly.
  actorClerkId           String?         @map("actor_clerk_id")
  userId                 String?         @map("user_id")
  user                   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([reportId, type])
  @@index([reportId, createdAt])
  @@index([type, createdAt])
  // Drives the contribution grid: per-user daily rollup straight from source.
  @@index([actorClerkId, createdAt])
  @@index([userId, createdAt])
  @@map("report_events")
}
